;; This test checks that a stackful task, which doesn't need its instance's
;; exclusive lock, can start as soon as its own backpressure check passes,
;; even if it got in line behind a task that is still waiting to enter.
;; Per `Task.enter_implicit_thread`, `num_waiting_to_enter > 0` only forces the
;; new task to suspend once; its wake condition is `not has_backpressure()`,
;; which ignores the exclusive lock when `needs_exclusive()` is false. In both
;; components below, the task waiting ahead of the stackful task needs the
;; exclusive lock, and the lock holder is waiting on the stackful task, so
;; holding the stackful task back until the waiting task enters would deadlock.

;; $A.f (callback-lifted) blocks in `waitable-set.wait`, holding $A's
;; exclusive lock, until stackful $A.g writes a future. $A.h (callback-lifted)
;; is waiting for the lock when $A.g is called.
(component
  (component $A
    (core module $libc (memory (export "mem") 1))
    (core instance $libc (instantiate $libc))
    (type $FT (future))
    (core func $future.new (canon future.new $FT))
    (core func $future.read (canon future.read $FT async (memory (core memory $libc "mem"))))
    (core func $waitable-set.new (canon waitable-set.new))
    (core func $waitable-set.wait (canon waitable-set.wait (memory (core memory $libc "mem"))))
    (core func $waitable.join (canon waitable.join))
    (core func $future.write (canon future.write $FT async (memory (core memory $libc "mem"))))
    (core func $future.drop-readable (canon future.drop-readable $FT))
    (core func $future.drop-writable (canon future.drop-writable $FT))
    (core func $task.return (canon task.return))
    (core module $m
      (import "libc" "mem" (memory 1))
      (import "" "future.new" (func $future.new (result i64)))
      (import "" "future.read" (func $future.read (param i32 i32) (result i32)))
      (import "" "future.write" (func $future.write (param i32 i32) (result i32)))
      (import "" "future.drop-readable" (func $future.drop-readable (param i32)))
      (import "" "future.drop-writable" (func $future.drop-writable (param i32)))
      (import "" "task.return" (func $task.return))
      (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
      (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import "" "waitable.join" (func $waitable.join (param i32 i32)))
      (global $w (mut i32) (i32.const 0))
      (func (export "f") (result i32)
        (local $fut i64) (local $r i32) (local $ws i32)
        (local.set $fut (call $future.new))
        (local.set $r (i32.wrap_i64 (local.get $fut)))
        (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $fut) (i64.const 32))))
        ;; async read: BLOCKED
        (if (i32.ne (call $future.read (local.get $r) (i32.const 0)) (i32.const -1))
          (then unreachable))
        ;; wait for it *inside the core function* (not by returning WAIT):
        ;; blocks until $g writes (FUTURE_READ = 4, COMPLETED = 0)
        (local.set $ws (call $waitable-set.new))
        (call $waitable.join (local.get $r) (local.get $ws))
        (if (i32.ne (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 4))
          (then unreachable))
        (if (i32.ne (i32.load (i32.const 4)) (i32.const 0)) (then unreachable))
        (call $waitable.join (local.get $r) (i32.const 0))
        (call $future.drop-readable (local.get $r))
        (call $task.return)
        (i32.const 0 (; EXIT ;)))
      (func (export "cb") (param i32 i32 i32) (result i32) unreachable)
      (func (export "h") (result i32) (call $task.return) (i32.const 0))
      (func (export "g")
        ;; the reader is waiting, so even the async write completes eagerly
        (if (i32.ne (call $future.write (global.get $w) (i32.const 0)) (i32.const 0))
          (then unreachable))
        (call $future.drop-writable (global.get $w))
        (call $task.return)))
    (core instance $i (instantiate $m
      (with "libc" (instance $libc))
      (with "" (instance
        (export "future.new" (func $future.new))
        (export "future.read" (func $future.read))
        (export "future.write" (func $future.write))
        (export "future.drop-readable" (func $future.drop-readable))
        (export "future.drop-writable" (func $future.drop-writable))
        (export "task.return" (func $task.return))
        (export "waitable-set.new" (func $waitable-set.new))
        (export "waitable-set.wait" (func $waitable-set.wait))
        (export "waitable.join" (func $waitable.join))))))
    (func (export "f") async (canon lift (core func $i "f") async (callback (core func $i "cb"))))
    (func (export "h") async (canon lift (core func $i "h") async (callback (core func $i "cb"))))
    (func (export "g") async (canon lift (core func $i "g") async)))

  (component $C
    (import "h" (func $h async))
    (import "f" (func $f async))
    (import "g" (func $g async))
    (core module $libc (memory (export "mem") 1))
    (core instance $libc (instantiate $libc))
    (core func $f (canon lower (func $f) async (memory (core memory $libc "mem"))))
    (core func $g (canon lower (func $g) async (memory (core memory $libc "mem"))))
    (core func $h (canon lower (func $h) async (memory (core memory $libc "mem"))))
    (core func $waitable-set.new (canon waitable-set.new))
    (core func $waitable-set.wait (canon waitable-set.wait (memory (core memory $libc "mem"))))
    (core func $waitable.join (canon waitable.join))
    (core func $subtask.drop (canon subtask.drop))
    (core func $task.return (canon task.return))
    (core module $m
      (import "" "f" (func $f (result i32)))
      (import "" "g" (func $g (result i32)))
      (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
      (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import "" "waitable.join" (func $waitable.join (param i32 i32)))
      (import "" "subtask.drop" (func $subtask.drop (param i32)))
      (import "" "task.return" (func $task.return))
      (import "" "h" (func $h (result i32)))
      (import "libc" "mem" (memory 1))
      (func (export "run")
        (local $ret i32) (local $ws i32) (local $n i32)
        (local.set $ws (call $waitable-set.new))
        ;; $A.f blocks: subtask 1, STARTED (1)
        (local.set $ret (call $f))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 1)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.h needs the lock: STARTING (0), subtask 2
        (local.set $ret (call $h))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.g: queued behind $A.h: STARTING (0)
        (local.set $ret (call $g))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; wait for all three to return
        (loop $l
          (if (i32.ne (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 1 (; SUBTASK ;)))
            (then unreachable))
          (if (i32.eq (i32.load (i32.const 4)) (i32.const 2))
            (then
              (call $waitable.join (i32.load (i32.const 0)) (i32.const 0))
              (call $subtask.drop (i32.load (i32.const 0)))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))))
          (br_if $l (i32.lt_u (local.get $n) (i32.const 3))))
        (call $task.return)))
    (core instance $i (instantiate $m (with "libc" (instance $libc)) (with "" (instance
      (export "f" (func $f))
      (export "h" (func $h))
      (export "g" (func $g))
      (export "waitable-set.new" (func $waitable-set.new))
      (export "waitable-set.wait" (func $waitable-set.wait))
      (export "waitable.join" (func $waitable.join))
      (export "subtask.drop" (func $subtask.drop))
      (export "task.return" (func $task.return))))))
    (func (export "run") async (canon lift (core func $i "run") async)))

  (instance $a (instantiate $A))
  (instance $c (instantiate $C (with "f" (func $a "f")) (with "h" (func $a "h")) (with "g" (func $a "g"))))
  (export "run" (func $c "run")))

(assert_return (invoke "run"))

;; Same shape, but $A.a holds the lock by suspending its thread with
;; `thread.suspend` and stackful $A.c is the one that wakes it with
;; `thread.resume-later`. $A.b is waiting for the lock when $A.c is called.
(component
  (component $A
    (core func $task.return (canon task.return))
    (core func $thread.index (canon thread.index))
    (core func $thread.suspend (canon thread.suspend))
    (core func $thread.resume-later (canon thread.resume-later))
    (core module $m
      (import "" "task.return" (func $task.return))
      (import "" "thread.index" (func $thread.index (result i32)))
      (import "" "thread.suspend" (func $thread.suspend (result i32)))
      (import "" "thread.resume-later" (func $thread.resume-later (param i32)))
      (global $a-thread (mut i32) (i32.const 0))
      (func (export "a") (result i32)
        (global.set $a-thread (call $thread.index))
        (drop (call $thread.suspend))
        (call $task.return)
        (i32.const 0 (; EXIT ;)))
      (func (export "b") (result i32) (call $task.return) (i32.const 0 (; EXIT ;)))
      (func (export "c")
        (call $thread.resume-later (global.get $a-thread))
        (call $task.return))
      (func (export "cb") (param i32 i32 i32) (result i32) unreachable))
    (core instance $i (instantiate $m (with "" (instance
      (export "task.return" (func $task.return))
      (export "thread.index" (func $thread.index))
      (export "thread.suspend" (func $thread.suspend))
      (export "thread.resume-later" (func $thread.resume-later))))))
    (func (export "a") async (canon lift (core func $i "a") async (callback (core func $i "cb"))))
    (func (export "b") async (canon lift (core func $i "b") async (callback (core func $i "cb"))))
    (func (export "c") async (canon lift (core func $i "c") async)))

  (component $C
    (import "a" (func $a async))
    (import "b" (func $b async))
    (import "c" (func $c async))
    (core module $libc (memory (export "mem") 1))
    (core instance $libc (instantiate $libc))
    (core func $a (canon lower (func $a) async (memory (core memory $libc "mem"))))
    (core func $b (canon lower (func $b) async (memory (core memory $libc "mem"))))
    (core func $c (canon lower (func $c) async (memory (core memory $libc "mem"))))
    (core func $waitable-set.new (canon waitable-set.new))
    (core func $waitable-set.wait (canon waitable-set.wait (memory (core memory $libc "mem"))))
    (core func $waitable.join (canon waitable.join))
    (core func $subtask.drop (canon subtask.drop))
    (core func $task.return (canon task.return))
    (core module $m
      (import "libc" "mem" (memory 1))
      (import "" "a" (func $a (result i32)))
      (import "" "b" (func $b (result i32)))
      (import "" "c" (func $c (result i32)))
      (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
      (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import "" "waitable.join" (func $waitable.join (param i32 i32)))
      (import "" "subtask.drop" (func $subtask.drop (param i32)))
      (import "" "task.return" (func $task.return))
      (func (export "run")
        (local $ret i32) (local $ws i32) (local $n i32)
        (local.set $ws (call $waitable-set.new))
        ;; $A.a suspends holding the lock: STARTED (1)
        (local.set $ret (call $a))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 1)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.b needs the lock: STARTING (0)
        (local.set $ret (call $b))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.c: queued behind $A.b: STARTING (0)
        (local.set $ret (call $c))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; wait for all three to return
        (loop $l
          (if (i32.ne (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 1 (; SUBTASK ;)))
            (then unreachable))
          (if (i32.eq (i32.load (i32.const 4)) (i32.const 2 (; RETURNED ;)))
            (then
              (call $waitable.join (i32.load (i32.const 0)) (i32.const 0))
              (call $subtask.drop (i32.load (i32.const 0)))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))))
          (br_if $l (i32.lt_u (local.get $n) (i32.const 3))))
        (call $task.return)))
    (core instance $i (instantiate $m (with "libc" (instance $libc)) (with "" (instance
      (export "a" (func $a))
      (export "b" (func $b))
      (export "c" (func $c))
      (export "waitable-set.new" (func $waitable-set.new))
      (export "waitable-set.wait" (func $waitable-set.wait))
      (export "waitable.join" (func $waitable.join))
      (export "subtask.drop" (func $subtask.drop))
      (export "task.return" (func $task.return))))))
    (func (export "run") async (canon lift (core func $i "run") async)))

  (instance $a (instantiate $A))
  (instance $c (instantiate $C (with "a" (func $a "a")) (with "b" (func $a "b")) (with "c" (func $a "c"))))
  (export "run" (func $c "run")))

(assert_return (invoke "run"))
